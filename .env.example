NODE_ENV=development
PORT=3000
APP_URL=https://your-domain.example
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/souqi
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Paymob Egypt — keep secret values server-side only
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_3DS_INTEGRATION_ID=
PAYMOB_MOTO_INTEGRATION_ID=
PAYMOB_PLUS_MONTHLY_PLAN_ID=
PAYMOB_PLUS_ANNUAL_PLAN_ID=

# FawryPay
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_WEBHOOK_URL=https://your-domain.example/api/webhooks/fawry
# Unattended token charges require explicit MOTO/recurring enablement in your Fawry contract.
FAWRY_MOTO_ENABLED=false
FAWRY_MOTO_CHARGE_URL=
