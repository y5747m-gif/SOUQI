# Server only. Enable Places API (New) + billing in Google Cloud.
# Restrict this key to Places API (New) and your server's public egress IP.
GOOGLE_PLACES_API_KEY=
PORT=3000
# Comma-separated exact public origins. In production set your HTTPS origin.
# For Arena preview, add the preview URL here if configuring this allowlist.
APP_ORIGINS=
# Limits are in-memory, per server process; use a shared gateway for multiple instances.
PLACES_PER_IP_PER_MINUTE=20
PLACES_GLOBAL_PER_MINUTE=100
PLACES_MAX_CONCURRENT=4
# Default false: do not trust client-supplied X-Forwarded-For.
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
