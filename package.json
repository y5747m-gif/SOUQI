{
  "name": "souqi-subscriptions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "worker": "node server/renewal-worker.js",
